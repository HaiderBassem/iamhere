# Copy to .env (never commit .env). Generate the password with: openssl rand -base64 32
POSTGRES_PASSWORD=
IAH_DOMAIN=attend.example.org
# Keycloak realm URL, e.g. https://auth.example.org/realms/iamhere
IAH_OIDC_ISSUER=
IAH_OIDC_CLIENT_ID=iamhere-web
# Origin (scheme + host, no path) of the Keycloak server above. The web app is only
# allowed to talk to this site and to itself.
IAH_AUTH_ORIGIN=https://auth.example.org
# Only needed when the web app is served from a different origin than the API
# (comma-separated exact origins, e.g. https://app.example.org). Leave empty otherwise.
IAH_CORS_ORIGINS=
# arm64 dev machines only:
# POSTGIS_IMAGE=imresamu/postgis:17-3.5-bookworm
# Strict mode's photo check runs in the "vision" container, one CPU core per check
# in progress: ~0.1 s when the room matches, up to ~2 s when it does not.
# IAH_VISION_WORKERS=2
# IAH_VISION_CPUS=2
