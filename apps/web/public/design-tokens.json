      "light": "#435B5B",
      "dark": "#88A2A2"
    },
    "ok": {
      "light": "#0B7A4B",
      "dark": "#2FD58A"
    },
    "ok-soft": {
      "light": "#E7F2ED",
      "dark": "#0F2C22"
