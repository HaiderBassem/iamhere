    }
  },
  "radius": {
    "md": "16px",
    "sm": "12px",
    "xs": "8px"
  },
  "shadow": {
    "resting": {
      "light": "0 1px 2px rgb(5 9 9 / .05)",
      "dark": "0 1px 2px rgb(0 0 0 / .4)"
    },
    "raised": {
      "light": "0 18px 40px -18px rgb(5 9 9 / .45), 0 2px 6px rgb(5 9 9 / .06)",
      "dark": "0 18px 40px -18px rgb(0 0 0 / .8), 0 2px 6px rgb(0 0 0 / .35)"
    }
  },
  "font": {
    "family": "\"Readex Pro\", ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", Roboto, \"Noto Sans\", \"Noto Naskh Arabic\", Arial, sans-serif",
    "mono": "ui-monospace, \"SF Mono\", \"Cascadia Mono\", Menlo, monospace",
    "weights": [
      400,
      500,
      600,
      700
    ],
    "size": {
      "body": "16px",
      "small": ".875rem",
      "eyebrow": ".75rem",
      "h3": "1.15rem",
      "h2": "1.4rem",
      "h1": "clamp(1.85rem, 1.5rem + 1.2vw, 2.4rem)",
      "display": "clamp(2.7rem, 1.5rem + 4.6vw, 4.6rem)"
    },
    "lineHeight": {
      "body": 1.55,
      "heading": 1.12,
      "display": 1.04
    },
    "display": "\"Baloo Bhaijaan 2\", \"Readex Pro\", ui-sans-serif, system-ui, sans-serif"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "28px"
  },
  "size": {
    "touchTarget": "48px",
    "input": "50px",
    "primaryAction": "56px",
    "contentMax": "760px",
    "landingMax": "1120px"
  },
  "breakpoint": {
    "tabbarToTopnav": "720px",
    "landingTwoColumn": "900px"
  },
  "motion": {
    "fast": ".15s",
    "enter": ".2s ease-out",
    "stamp": ".35s cubic-bezier(.2, 1.6, .4, 1)",
    "reducedMotion": "all animation off"
  },
  "motif": {
    "pattern": "/assets/pattern.svg (160px tile, CSS mask)",
    "frieze": "/assets/frieze.svg (64x32, CSS mask, repeat-x)",
    "mark": "highlighter under one phrase; a solid cyan label on dark surfaces"
  }
}
